# Copy to .env and fill in. Never commit the real .env file.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-64-char-random-hex-value

# --- Database (Postgres, provisioned by docker-compose.yml) ---
DATABASE_URL=postgres://cim:cim@localhost:5432/cim

# --- Redis (queue + cache, provisioned by docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Search (Meilisearch, Phase 2 — optional in MVP, Postgres FTS is default) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Object storage (S3-compatible, MinIO in docker-compose.yml) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cim-dev
S3_ACCESS_KEY_ID=cim-dev
S3_SECRET_ACCESS_KEY=cim-dev-secret

# --- Email provider abstraction ---
# "console" writes emails to server logs + an EmailOutbox DB table for
# local dev/E2E; swap to a real provider id when one is wired up.
EMAIL_PROVIDER=console
EMAIL_FROM="CiM <no-reply@cim.example>"

# --- AI provider abstraction (see packages/ai) ---
# disabled: no enrichment, AI fields show "Not available". mock: deterministic
# heuristic provider, no key needed — set this for local dev/demo. anthropic:
# real model, requires AI_API_KEY. openai: reserved, not yet implemented.
AI_PROVIDER=disabled
AI_API_KEY=
AI_CHEAP_MODEL=claude-haiku-4-5
AI_SYNTHESIS_MODEL=claude-sonnet-5

# --- Default timezone/locale (organization/user-level override in-app) ---
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr
